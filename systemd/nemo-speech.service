[Unit]
Description=Nemotron 3.5 ASR server (live dictation sidecar)
Documentation=https://github.com/NVIDIA/NeMo-Speech.cpp
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/nemo-speech serve --asr-model nemotron-3.5 --device cpu --host 127.0.0.1 --port 18765 --no-ui
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
