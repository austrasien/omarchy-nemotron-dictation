-- BEGIN omarchy-nemotron-dictation
-- Live French dictation: Nemotron 3.5 sidecar (not Voxtype). Toggle, not
-- push-to-talk: Hyprland loses the key-release if you type into the focused
-- window while holding a bind.
-- Was: Voxtype `record toggle` / F9 PTT. Rollback: disable nemo-speech,
-- enable --now voxtype, delete this block.
hl.unbind("SUPER + CTRL + X")
hl.unbind("F9")
o.bind("SUPER + CTRL + X", "Toggle dictation", os.getenv("HOME") .. "/.config/omarchy/bin/nemotron-dictation toggle")
o.bind("F9", "Toggle dictation", os.getenv("HOME") .. "/.config/omarchy/bin/nemotron-dictation toggle")

-- While dictating, any key stops and finishes the transcription; Esc cancels.
-- The catchall holds the key back so it can't land mid-transcript; the client
-- types it (nemotron_keys_dump + wtype) once the dictated text is typed. The
-- client leaves this submap around every wtype call: bind device filters
-- can't reliably tell wtype from the real keyboard.
local DICTATION_BIN = os.getenv("HOME") .. "/.config/omarchy/bin/nemotron-dictation"

-- Held-back keys, in order (xkb keycodes + modifiers). The key event fires
-- for every keyboard, wtype and fcitx5 included, and carries no modifiers;
-- the catchall only fires for keys it swallows. So the event notes the key
-- and the catchall, which runs right after it, keeps it.
local dictation_keys = {}
local dictation_pending = nil
local dictation_mods = {
  { "SHIFT", { 50, 62 } },
  { "CTRL", { 37, 105 } },
  { "ALT", { 64 } },
  { "MOD5", { 108 } }, -- AltGr
}
-- Modifiers alone, F9 (toggle) and Super chords stop the take but aren't typed.
local DICTATION_SKIP = { [75] = true, [50] = true, [62] = true, [37] = true, [105] = true, [64] = true, [108] = true, [133] = true, [134] = true }

hl.on("input.keyboard.key", function(code, _time, state)
  if state ~= 1 or hl.get_current_submap() ~= "dictation" then
    return
  end
  if DICTATION_SKIP[code] or hl.is_key_down(133) or hl.is_key_down(134) then
    dictation_pending = nil
    return
  end
  local mods = {}
  for _, m in ipairs(dictation_mods) do
    for _, c in ipairs(m[2]) do
      if hl.is_key_down(c) then
        table.insert(mods, m[1])
        break
      end
    end
  end
  dictation_pending = { code = code, mods = table.concat(mods, " ") }
end)

hl.define_submap("dictation", function()
  hl.bind("Escape", hl.dsp.exec_cmd(DICTATION_BIN .. " cancel"), { description = "Cancel dictation" })
  hl.bind("catchall", function()
    if dictation_pending then
      table.insert(dictation_keys, dictation_pending)
      dictation_pending = nil
    end
    hl.exec_cmd(DICTATION_BIN .. " stop")
  end, { ignore_mods = true, description = "Finish dictation" })
end)

function nemotron_keys_clear()
  dictation_keys = {}
  dictation_pending = nil
end

-- Write "keycode mods" lines to path for the client, then forget them.
function nemotron_keys_dump(path)
  local keys = dictation_keys
  nemotron_keys_clear()
  local f = io.open(path, "w")
  if not f then
    return
  end
  for _, k in ipairs(keys) do
    f:write(k.code .. " " .. k.mods .. "\n")
  end
  f:close()
end
-- END omarchy-nemotron-dictation
